# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# ONNX Runtime is placed here by scripts/setup-onnx.cjs (a local Python install
# or a downloaded release). It is a ~17 MB binary and must never be committed.
# The `*_providers_shared` library travels with it on every platform.
/onnxruntime.dll
/libonnxruntime.so
/libonnxruntime.so.*
/libonnxruntime.dylib
/onnxruntime_providers_shared.dll
/libonnxruntime_providers_shared.so
/libonnxruntime_providers_shared.dylib
/ort-extract/
/*.tmp
