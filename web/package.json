{
	"name": "@stylenotes/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "StyleNotes landing site — SvelteKit on Cloudflare Workers.",
	"license": "AGPL-3.0-only",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "node scripts/sync-assets.mjs && svelte-kit sync",
		"predev": "node scripts/sync-assets.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/sync-assets.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"preview:cf": "wrangler dev",
		"precheck": "node scripts/sync-assets.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "wrangler deploy",
		"deploy:dry": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"cn": "^0.3.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.118.0"
	}
}
